local function formatarTempo(segundos)
	local min = math.floor(segundos / 60)
	local seg = segundos % 60
	return string.format("Tempo: %02d:%02d", min, seg)
end

local function iniciarMinigame()
	if emJogo then return end
	emJogo = true

	local forma = FORMAS[math.random(1, #FORMAS)]

	local personagem = player.Character
	local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
	local velocidadeOriginal = humanoid and humanoid.WalkSpeed
	if humanoid then
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
	end

	local screenGui, biscoito, faca, status, progresso, tempoLabel, rachaduras1, rachaduras2 = criarGui()
	screenGui.Parent = player:WaitForChild("PlayerGui")

	local camera = workspace.CurrentCamera
	local centro = camera.ViewportSize / 2

	local segmentos = criarLinhasDoContorno(screenGui.Overlay, centro, forma)

	status.Text = "Corte o " .. forma.nome .. "! Erros: 0/" .. MAX_ERROS
	tempoLabel.Text = formatarTempo(TEMPO_LIMITE)

	local erros = 0
	local anguloJaCortado = {}
	local terminou = false
	local foraDaTolerancia = false
	local ultimoBucket = nil

	local function marcarBucket(b)
		if not anguloJaCortado[b] then
			anguloJaCortado[b] = true
			marcarSegmentoCortado(segmentos[b])
		end
	end

	local function finalizar(venceu)
		if terminou then return end
		terminou = true

		if humanoid and velocidadeOriginal then
			humanoid.WalkSpeed = velocidadeOriginal
			humanoid.JumpPower = 50
		end

		if venceu then
			status.Text = "Você cortou certinho!"
			status.TextColor3 = Color3.fromRGB(120, 255, 120)
		else
			status.Text = "Você errou demais..."
			status.TextColor3 = Color3.fromRGB(255, 80, 80)
			if humanoid then
				humanoid.Health = 0
			end
		end

		task.wait(1.2)
		screenGui:Destroy()

		ultimoUso = os.clock()
		emJogo = false
	end

	task.spawn(function()
		local restante = TEMPO_LIMITE
		while restante > 0 and not terminou do
			tempoLabel.Text = formatarTempo(restante)
			task.wait(1)
			restante -= 1
		end
		if not terminou then
			finalizar(false)
		end
	end)

	local heartbeatConn
	heartbeatConn = RunService.RenderStepped:Connect(function()
		if terminou then return end

		local mousePos = UserInputService:GetMouseLocation()
		faca.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)

		local mouseSegurado = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)

		local diferenca = mousePos - centro
		local distancia = diferenca.Magnitude
		local anguloMouse = (math.deg(math.atan2(diferenca.Y, diferenca.X)) + 360) % 360
		local raioEsperado = raioNoAngulo(anguloMouse, forma)
		local desvio = math.abs(distancia - raioEsperado)

		if mouseSegurado then
			if desvio <= TOLERANCIA then
				faca.BackgroundColor3 = Color3.fromRGB(90, 220, 90)
				foraDaTolerancia = false

				local bucketAtual = math.floor(anguloMouse / (360 / TOTAL_SEGMENTOS))

				if ultimoBucket == nil then
					marcarBucket(bucketAtual)
				else
					local diff = bucketAtual - ultimoBucket
					if diff > TOTAL_SEGMENTOS / 2 then
						diff -= TOTAL_SEGMENTOS
					elseif diff < -TOTAL_SEGMENTOS / 2 then
						diff += TOTAL_SEGMENTOS
					end

					if math.abs(diff) <= MAX_SALTO_BUCKETS then
						local passo = diff >= 0 and 1 or -1
						for i = 0, math.abs(diff) do
							local b = (ultimoBucket + i * passo) % TOTAL_SEGMENTOS
							marcarBucket(b)
						end
					else
						marcarBucket(bucketAtual)
					end
				end
				ultimoBucket = bucketAtual

				local total = 0
				for i = 0, TOTAL_SEGMENTOS - 1 do
					if anguloJaCortado[i] then
						total += 1
					end
				end
				local pct = total / TOTAL_SEGMENTOS
				progresso.Text = "Progresso: " .. math.floor(pct * 100) .. "%"

				if pct >= PORCENTAGEM_PRA_VENCER then
					finalizar(true)
				end
			else
				faca.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
				ultimoBucket = nil
				if not foraDaTolerancia then
					foraDaTolerancia = true
					erros += 1
					status.Text = "Cuidado! Erros: " .. erros .. "/" .. MAX_ERROS
					criarRachaduraCursor(screenGui.Overlay, mousePos)

					local transparenciaAlvo = 1 - (erros / MAX_ERROS)
					rachaduras1.ImageTransparency = transparenciaAlvo
					rachaduras2.ImageTransparency = transparenciaAlvo

					if erros >= MAX_ERROS then
						finalizar(false)
					end
				end
			end
		else
			faca.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
			foraDaTolerancia = false
			ultimoBucket = nil
		end
	end)

	task.spawn(function()
		while not terminou do
			task.wait(0.2)
		end
		task.wait(1.3)
		if heartbeatConn then heartbeatConn:Disconnect() end
	end)
end

RunService.Heartbeat:Connect(function()
	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local dist = (root.Position - TARGET_POS).Magnitude
	if dist <= RAIO_DETECCAO then
		local emCooldown = (os.clock() - ultimoUso) < COOLDOWN
		if not emJogo and not emCooldown then
			iniciarMinigame()
		end
	end
end)
