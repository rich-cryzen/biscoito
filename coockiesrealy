local function criarLinhasDoContorno(overlay, centro, forma)
	local segmentos = {}
	for i = 0, TOTAL_SEGMENTOS - 1 do
		local anguloA = i * (360 / TOTAL_SEGMENTOS)
		local anguloB = (i + 1) * (360 / TOTAL_SEGMENTOS)
		local pA = pontoNoAngulo(anguloA, forma, centro)
		local pB = pontoNoAngulo(anguloB, forma, centro)

		local diferenca = pB - pA
		local comprimento = diferenca.Magnitude
		local meio = (pA + pB) / 2
		local anguloRotacao = math.deg(math.atan2(diferenca.Y, diferenca.X))

		local segmento = Instance.new("Frame")
		segmento.Name = "Segmento" .. i
		segmento.AnchorPoint = Vector2.new(0.5, 0.5)
		segmento.Position = UDim2.new(0, meio.X, 0, meio.Y)
		segmento.Size = UDim2.new(0, comprimento + 3, 0, LINHA_ESPESSURA)
		segmento.Rotation = anguloRotacao
		segmento.BackgroundColor3 = Color3.fromRGB(196, 110, 40)
		segmento.BorderSizePixel = 0
		segmento.ZIndex = 4
		segmento.Parent = overlay

		segmentos[i] = segmento
	end
	return segmentos
end

local function marcarSegmentoCortado(segmento)
	segmento.BackgroundColor3 = Color3.fromRGB(70, 255, 90)
	segmento.Size = UDim2.new(0, segmento.Size.X.Offset, 0, LINHA_ESPESSURA + 4)

	if not segmento:FindFirstChild("Brilho") then
		local brilho = Instance.new("UIStroke")
		brilho.Name = "Brilho"
		brilho.Thickness = 2
		brilho.Color = Color3.fromRGB(150, 255, 160)
		brilho.Transparency = 0.2
		brilho.Parent = segmento
	end
end

