local BASE_ANGULO = -90

local emJogo = false
local ultimoUso = 0

local function raioNoAngulo(anguloGraus, forma)
	if not forma.lados then
		return RAIO_CIRCULO
	end
	local n = forma.lados
	local anguloPorLado = 360 / n
	local apotema = RAIO_CIRCULO * math.cos(math.rad(180 / n))
	local relativo = (anguloGraus - BASE_ANGULO) % 360
	local anguloDentroSetor = relativo % anguloPorLado
	local anguloRel = anguloDentroSetor - anguloPorLado / 2
	return apotema / math.cos(math.rad(anguloRel))
end

local function pontoNoAngulo(anguloGraus, forma, centro)
	local raio = raioNoAngulo(anguloGraus, forma)
	return Vector2.new(
		centro.X + raio * math.cos(math.rad(anguloGraus)),
		centro.Y + raio * math.sin(math.rad(anguloGraus))
	)
end

